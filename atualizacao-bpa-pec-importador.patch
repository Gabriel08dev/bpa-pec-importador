--- /dev/null
+++ b/scripts/preparar_modelo.py
@@ -0,0 +1,23 @@
+"""Gera o modelo local sem interpolar caminhos em código Python via PowerShell."""
+
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from app.services.professional_service import ProfessionalRegistry
+from app.services.spreadsheet_service import create_template
+
+
+def main() -> None:
+    registry = ProfessionalRegistry(ROOT / "data" / "profissionais.json")
+    create_template(
+        ROOT / "outputs" / "modelo_controle_atendimentos.xlsx",
+        [professional.name for professional in registry.items],
+    )
+
+
+if __name__ == "__main__":
+    main()
