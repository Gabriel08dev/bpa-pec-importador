new file mode 100644
index 0000000..fdee0d4
--- /dev/null
+++ b/.github/workflows/tests.yml
@@ -0,0 +1,56 @@
+name: Testes
+
+on:
+  push:
+    branches: [main, 'codex/**']
+  pull_request:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: testes-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  windows:
+    name: Windows / Python 3.12
+    runs-on: windows-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@v6
+        with:
+          python-version: '3.12'
+          cache: pip
+          cache-dependency-path: requirements.txt
+      - name: Bloquear arquivos operacionais no repositório
+        shell: pwsh
+        run: |
+          $blockedPaths = @(git ls-files | Where-Object {
+            $_ -match '(^|/)(outputs|backups|\.pec_profile|\.diagnostics)/' -or
+            $_ -match '^data/(config|profissionais)\.json$' -or
+            $_ -match '(^|/)\.env($|\.)' -or
+            $_ -match '\.(gdb|fdb|fbk|db|sqlite3?|bak|bkp|xlsx?|csv|tsv|pdf|zip|7z|rar|sql|pem|key|pfx|log)$'
+          })
+          if ($LASTEXITCODE -ne 0) { throw 'Nao foi possivel listar os arquivos versionados.' }
+          if ($blockedPaths.Count) { throw ('Arquivos operacionais nao devem ser publicados: ' + ($blockedPaths -join ', ')) }
+      - name: Instalar dependências
+        run: python -m pip install -r requirements.txt
+      - name: Verificar dependências
+        run: python -m pip check
+      - name: Executar testes com dados sintéticos
+        run: python -m pytest -m "not firebird"
+      - name: Validar sintaxe dos scripts PowerShell
+        shell: pwsh
+        run: |
+          Get-ChildItem scripts -Filter *.ps1 | ForEach-Object {
+            $scriptTokens = $null
+            $scriptErrors = $null
+            [void][System.Management.Automation.Language.Parser]::ParseFile($_.FullName, [ref]$scriptTokens, [ref]$scriptErrors)
+            if ($scriptErrors.Count) { throw ($scriptErrors | Out-String) }
+          }
